{
  "name": "ultravox-client",
  "version": "0.6.0",
  "private": false,
  "files": [
    "dist"
  ],
  "tshy": {
    "dialects": [
      "esm"
    ],
    "exclude": [
      "src/**/*.test.ts"
    ],
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "gen-version": "node -p \"'export const ULTRAVOX_SDK_VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts",
    "build": "pnpm run prepare && pnpm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "pnpm run gen-version && tshy",
    "serve-example": "pnpm run prepare && http-server",
    "test": "vitest run"
  },
  "dependencies": {
    "livekit-client": "^2.20.1"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "prettier": "^3.9.4",
    "tshy": "^4.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true
  },
  "engines": {
    "pnpm": ">=6.0.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/esm/index.js"
}
